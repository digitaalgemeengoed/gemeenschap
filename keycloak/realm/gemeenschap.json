{
  "realm": "gemeenschap",
  "enabled": true,
  "displayName": "Digitaal GemeenGoed",
  "displayNameHtml": "<span>Digitaal GemeenGoed</span>",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "organizationsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "nl",
    "en"
  ],
  "defaultLocale": "nl",
  "loginTheme": "digitaalgemeengoed",
  "accountTheme": "keycloak.v3",
  "emailTheme": "keycloak",
  "smtpServer": {
    "host": "$(env:SMTP_HOST:-)",
    "port": "$(env:SMTP_POORT:-587)",
    "from": "$(env:SMTP_AFZENDER:-noreply@digitaalgemeengoed.nl)",
    "fromDisplayName": "Digitaal GemeenGoed",
    "replyTo": "$(env:SMTP_AFZENDER:-noreply@digitaalgemeengoed.nl)",
    "starttls": "$(env:SMTP_STARTTLS:-true)",
    "ssl": "$(env:SMTP_SSL:-false)",
    "auth": "true",
    "user": "$(env:SMTP_GEBRUIKER:-)",
    "password": "$(env:SMTP_WACHTWOORD:-)"
  },
  "defaultGroups": [
    "/netwerk/gebruikers"
  ],
  "groups": [
    {
      "name": "netwerk",
      "subGroups": [
        {
          "name": "gebruikers",
          "attributes": {
            "omschrijving": [
              "Melden, reageren, fora. Iedereen die zich aanmeldt."
            ]
          }
        },
        {
          "name": "contributors",
          "attributes": {
            "omschrijving": [
              "Issues oppakken, wiki, bijdragen."
            ]
          }
        },
        {
          "name": "members",
