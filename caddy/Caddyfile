# VPS 4 — gemeenschap. Caddy haalt zelf certificaten op voor alle namen.
# Nodig in DNS: A-records (of CNAME's) naar deze server voor <domein>,
# www.<domein>, aanmelden.<domein>, projecten.<domein> en forum.<domein>.

# Afschermen met gebruikersnaam en wachtwoord zolang het platform niet openbaar
# is: server/afschermen.sh zet DG_TOEGANG op dicht of open. Verkeer van de
# server zelf en uit de containers (privé-adressen) hoeft niet in te loggen,
# zodat de controles, wp-cron en het inloggen via Keycloak blijven werken.
#
# Na het inloggen krijgt de browser een cookie (dg_toegang, voor het domein en
# alle subdomeinen); met dat cookie hoeft het niet opnieuw. Nodig voor
# programma's die zelf een Authorization-kop sturen: de kennisbank (Wiki.js)
# stuurt na het inloggen "Bearer <token>" mee, waardoor de browser het
# wachtwoord van de afscherming niet meer kan meesturen. Eén keer inloggen
# geldt zo ook voor alle subdomeinen. De waarde (DG_TOEGANG_COOKIE) is
# geheim en wisselt bij elk nieuw wachtwoord.
(toegang-open) {
}

(toegang-dicht) {
	@extern {
		not remote_ip private_ranges
		not header Cookie *dg_toegang={$DG_TOEGANG_COOKIE}*
		# Een uitnodiging om lid te worden (wordpress/dg-uitnodigen.php): de site
		# controleert de sleutel en zet dan zelf het cookie.
		not path /uitnodiging/* /.well-known/matrix/*
	}
	# In deze volgorde: het cookie alleen na een geslaagde aanmelding.
	route {
		basic_auth @extern {
			{$DG_TOEGANG_GEBRUIKER} {$DG_TOEGANG_HASH}
		}
		header @extern +Set-Cookie "dg_toegang={$DG_TOEGANG_COOKIE}; Domain={$DOMEIN}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
	}
}

(beveiliging) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	encode zstd gzip
	# XML-RPC is een bekend doelwit en hier niet nodig.
	@xmlrpc path /xmlrpc.php
	respond @xmlrpc 404
	# Wie WordPress-gebruikers opsomt via de REST-API, krijgt niets (ledenlijsten alleen ingelogd, in BuddyPress).
	@gebruikers path /wp-json/wp/v2/users*
	respond @gebruikers 404
	# Het berichteneindpunt van Documenten (/wp-json/dg/...) is alleen voor binnen het
	# Docker-netwerk. Het geheim is de echte slot; dit is de tweede.
	@intern expression `{path}.matches("(?i)^/+wp-json/+dg/") || {query.rest_route}.matches("(?i)^/*dg/")`
	respond @intern 404
	# Chat (Matrix): waar de server staat. Gebruikersnamen zijn @naam:{$DOMEIN}.
	header /.well-known/matrix/* Access-Control-Allow-Origin "*"
	header /.well-known/matrix/* Content-Type application/json
	respond /.well-known/matrix/client `{"m.homeserver":{"base_url":"https://matrix.{$DOMEIN}"}}` 200
	respond /.well-known/matrix/server `{"m.server":"matrix.{$DOMEIN}:443"}` 200
	reverse_proxy wordpress:80
}

# --- Chat (Matrix) ----------------------------------------------------------------
# De chatserver en het inloggen staan buiten de afscherming: een app op de
# telefoon kan het wachtwoord daarvan niet invullen. Wie wil inloggen, heeft
# altijd een account in Keycloak nodig (MAS stuurt door naar aanmelden.).
matrix.{$DOMEIN} {
	import beveiliging
	# Inloggen, uitloggen en tokens vernieuwen: naar MAS.
	@mas path_regexp ^/_matrix/client/[^/]+/(login|logout|refresh)
	reverse_proxy @mas mas:8080
	# Alleen de API's voor apps en (als die aan staat) federatie; de beheer-API van Synapse niet.
	@synapse path /_matrix/* /_synapse/client/*
	reverse_proxy @synapse synapse:8008
	respond 404
}

matrix-auth.{$DOMEIN} {
	import beveiliging
	reverse_proxy mas:8080
}

# Element Web: de chat in de browser (achter de afscherming als die aan staat).
chat.{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	reverse_proxy element:80
}

www.{$DOMEIN} {
	redir https://{$DOMEIN}{uri} permanent
}

forum.{$DOMEIN} {
	redir https://{$DOMEIN}/forum{uri} permanent
}

aanmelden.{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	# Het beheerscherm van Keycloak niet naar buiten; via de SSH-tunnel (README.md, Beheer op de server).
	@beheer path /admin*
	respond @beheer "Niet beschikbaar" 404
	@root path /
	redir @root https://{$DOMEIN}/ 302
	reverse_proxy keycloak:8080
}

projecten.{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	encode zstd gzip
	reverse_proxy redmine:3000
}

# De kennisbank (Wiki.js). Alleen voor leden: dat regelt de wiki zelf (gasten
# mogen niets en worden naar het inloggen via Keycloak gestuurd).
kennis.{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	encode zstd gzip
	reverse_proxy wiki:3000
}

# Documenten (dg-documenten): bestanden van de coöperatie en per project.
# Alleen voor leden: dat regelt de dienst zelf (inloggen via Keycloak).
documenten.{$DOMEIN} {
	import beveiliging
	# WebDAV (/dav/: app-wachtwoord; /o/: tijdelijke link) logt zelf in met
	# Basic; de afscherming met wachtwoord zou daar dubbel op zitten (een
	# programma kan maar één wachtwoord sturen). Daarom buiten de afscherming.
	# Alleen voor WordPress op het interne netwerk (documenten/intern.go).
	@intern path /intern/*
	handle @intern {
		respond 404
	}
	@webdav path /dav /dav/* /o/*
	handle @webdav {
		reverse_proxy documenten:8080
	}
	handle {
		import toegang-{$DG_TOEGANG:open}
		reverse_proxy documenten:8080
	}
}

# Beheer (dg-beheer): voor de beheerders van het platform en de kerngroep.
# De dienst controleert zelf wie er binnenkomt (Keycloak).
beheer.{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	reverse_proxy beheer:8080
}

# De architectuurmodellen: de HTML-rapporten van Archi (server/architectuur.sh
# bouwt ze in /srv/dg-architectuur). Alleen voor leden: oauth2-proxy vraagt
# Keycloak wie er is; wie niet is ingelogd, gaat eerst naar het inloggen.
architectuur.{$DOMEIN} {
	import beveiliging
	import toegang-{$DG_TOEGANG:open}
	encode zstd gzip
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			@niet_ingelogd status 401
			handle_response @niet_ingelogd {
				redir * /oauth2/start?rd={scheme}://{hostport}{uri} 302
			}
		}
		root * /srv/architectuur
		file_server
	}
}
